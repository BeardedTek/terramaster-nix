MINIO_ROOT_USER='minioadmin'
MINIO_ROOT_PASSWORD='change-me-to-a-real-secret-at-least-8-chars'

# Copy this directory's contents (minus .example suffixes) into
# secrets/nas-secrets-usb/ to bake credentials like this into the
# installer image at build time instead of relying on the wizard's
# auto-generated placeholder. See ../../../extra-files/persist/etc/minio/minio.env.example
# for the OIDC-client-secret caveat (unrelated to this file, handled
# automatically at install time either way).
