# Standard nebula config.yaml (see https://nebula.defined.net/docs/) —
# modules/nebula.nix runs `nebula -config /etc/nebula/config.yaml`
# verbatim, no BeardedNAS-specific fields. Certs referenced below
# (ca.crt/host.crt/host.key) should sit alongside this file in the same
# secrets/nas-secrets-usb/etc/nebula/ directory; the installer copies the
# whole etc/nebula/ tree in as-is.

pki:
  ca: /etc/nebula/ca.crt
  cert: /etc/nebula/host.crt
  key: /etc/nebula/host.key

static_host_map:
  "192.168.100.1": ["lighthouse.example.com:4242"]

lighthouse:
  am_lighthouse: false
  hosts:
    - "192.168.100.1"

listen:
  host: 0.0.0.0
  port: 4242

punchy:
  punch: true

tun:
  disabled: false
  dev: nebula1

firewall:
  outbound:
    - port: any
      proto: any
      host: any
  inbound:
    - port: any
      proto: any
      host: any
