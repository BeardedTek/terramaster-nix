# Same shape/content as ../../../extra-files/persist/etc/traefik/traefik.env.example
# — copy that file's real DNS-01 provider block here (or fill in below)
# to have the installer wizard's Secrets/DNS-01 steps pick it up
# automatically instead of prompting, same as a NAS-SECRETS USB drive
# would today. See hosts/installer/wizard/stages/71-dns01.sh for the
# full per-provider field list.

TRAEFIK_DNS_PROVIDER='linode'
TRAEFIK_EXTRA_DOMAIN='custom.example.com'
TRAEFIK_EXTRA_WILDCARD='*.custom.example.com'

# --- linode ---
LINODE_TOKEN='your-linode-api-token-here'

# --- cloudflare ---
# CF_DNS_API_TOKEN='your-cloudflare-api-token-here'

# --- digitalocean ---
# DO_AUTH_TOKEN='your-digitalocean-api-token-here'

# --- route53 (AWS) ---
# AWS_ACCESS_KEY_ID='...'
# AWS_SECRET_ACCESS_KEY='...'

# --- duckdns ---
# DUCKDNS_TOKEN='...'
