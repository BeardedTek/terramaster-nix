# Do NOT set this to a real person's LLDAP username (e.g. a name from
# mySystem.users) once mySystem.features.sso.authelia.enable is on —
# FileBrowser Quantum re-pins whichever username matches this value back
# to password-only login on every single startup (confirmed the hard
# way: it silently broke OIDC login for that person, with a generic
# "wrong login method" error and no indication why). Keep this a purely
# local break-glass account, distinct from every real identity.
FILEBROWSER_ADMIN_USER='admin'
FILEBROWSER_ADMIN_PASSWORD='change-me-to-a-real-secret'
