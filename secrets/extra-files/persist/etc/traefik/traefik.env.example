# Normally managed for you: the dashboard's "Let's Encrypt" preferences
# accordion (modules/traefik-dns01.nix) writes this whole file on save,
# and traefik-dns01-defaults.service seeds a harmless placeholder here
# before Traefik's first ever start if nobody's touched that page yet —
# see modules/traefik.nix's dnsChallenge.provider, which reads
# TRAEFIK_DNS_PROVIDER at every Traefik start via the same envsubst
# mechanism that makes this whole file optional in the first place.
#
# This example is for provisioning a box by hand instead (bypassing the
# dashboard entirely) — pick ONE provider's block below and delete the
# rest. TRAEFIK_DNS_PROVIDER's value must be one of the ids on the left.
# TRAEFIK_EXTRA_DOMAIN/TRAEFIK_EXTRA_WILDCARD are independent of provider
# choice — an extra domain+wildcard cert Traefik requests/serves (at the
# dashboard) on top of the two it always requests for mySystem.domain
# itself.

TRAEFIK_DNS_PROVIDER='linode'
TRAEFIK_EXTRA_DOMAIN='custom.example.com'
TRAEFIK_EXTRA_WILDCARD='*.custom.example.com'

# --- linode ---
LINODE_TOKEN='your-linode-api-token-here'

# --- cloudflare ---
# CF_DNS_API_TOKEN='your-cloudflare-api-token-here'

# --- digitalocean ---
# DO_AUTH_TOKEN='your-digitalocean-api-token-here'

# --- route53 (AWS) ---
# AWS_ACCESS_KEY_ID='...'
# AWS_SECRET_ACCESS_KEY='...'

# --- duckdns ---
# DUCKDNS_TOKEN='...'

# --- godaddy ---
# GODADDY_API_KEY='...'
# GODADDY_API_SECRET='...'

# --- namecheap ---
# NAMECHEAP_API_USER='...'
# NAMECHEAP_API_KEY='...'

# --- gcloud (Google Cloud DNS) ---
# GCE_PROJECT='...'
# GCE_SERVICE_ACCOUNT_FILE='/etc/traefik/gce-service-account.json'
# ^ the dashboard's own gcloud form pastes the JSON directly and writes
#   this file for you; provisioning by hand means dropping that file at
#   this exact path yourself.

# --- azure ---
# AZURE_CLIENT_ID='...'
# AZURE_CLIENT_SECRET='...'
# AZURE_SUBSCRIPTION_ID='...'
# AZURE_TENANT_ID='...'
# AZURE_RESOURCE_GROUP='...'

# --- ovh ---
# OVH_ENDPOINT='ovh-eu'
# OVH_APPLICATION_KEY='...'
# OVH_APPLICATION_SECRET='...'
# OVH_CONSUMER_KEY='...'

# --- porkbun ---
# PORKBUN_API_KEY='...'
# PORKBUN_SECRET_API_KEY='...'

# --- vultr ---
# VULTR_API_KEY='...'

# --- hetzner ---
# HETZNER_API_KEY='...'

# --- gandi ---
# GANDI_BEARER_TOKEN='...'

# --- desec ---
# DESEC_TOKEN='...'
