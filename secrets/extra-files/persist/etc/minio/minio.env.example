MINIO_ROOT_USER='minioadmin'
MINIO_ROOT_PASSWORD='change-me-to-a-real-secret-at-least-8-chars'

# The OIDC client secret (MINIO_IDENTITY_OPENID_CLIENT_SECRET) is NOT set
# here — it's generated automatically at install time (or via a one-time
# manual step for an already-installed host) at
# /persist/etc/authelia/oidc-clients/minio-console_secret, read directly
# by modules/minio.nix. See modules/authelia.nix's oidcSecretsDir comment.
