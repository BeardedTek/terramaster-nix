MINIO_ROOT_USER='minioadmin'
MINIO_ROOT_PASSWORD='change-me-to-a-real-secret-at-least-8-chars'

# Only if mySystem.features.sso.authelia.enable = true — the rest of the
# MINIO_IDENTITY_OPENID_* settings are plain Nix-derived values set
# declaratively in modules/minio.nix; this is the one genuinely secret
# one, matching the Authelia OIDC client secret registered in
# modules/authelia.nix's candidateOidcClients."minio-console".
MINIO_IDENTITY_OPENID_CLIENT_SECRET='change-me-to-the-oidc-client-plaintext-secret'
