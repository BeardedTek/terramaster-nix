# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Downloaded/built installer ISOs — never belong in the repo
*.iso
/build/

# Hugo + npm build artifacts for docs/ (the documentation site)
docs/public/
docs/resources/
docs/node_modules/
docs/.hugo_build.lock
node_modules/

# Secrets staged for delivery via `nixos-anywhere --extra-files` (SSH
# authorized_keys, the Nebula config.yaml with its embedded private key,
# etc.) — never commit the real files. `*.example` placeholders documenting
# expected paths/format ARE tracked (the negation patterns below re-include
# them despite the broad ignore).
secrets/**
!secrets/**/
!secrets/**/*.example

# Each real host's own variables.nix (hostname, contact info, which
# features are on) — copy variables.nix.example to
# hosts/<manufacturer>/<instance>/variables.nix and fill it in locally;
# never committed. flake.nix reads these through a real absolute
# filesystem path specifically so this stays readable by `nix build`/
# `nix eval` despite being gitignored — see its own repoRoot comment.
hosts/*/*/variables.nix
